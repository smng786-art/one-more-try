# ONE MORE TRY! - Environment Variables Template

# Application Port & Canonical URL
PORT=3000
NEXT_PUBLIC_APP_URL=https://onemoretry.game

# Supabase Configuration (Optional - In-Memory / Local fallback works automatically out-of-the-box)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Game Secret for Anti-Cheat HMAC (Optional)
GAME_SECRET=change-this-to-a-secure-random-token-in-production
